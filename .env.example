# Set to 1 only behind a reverse proxy that appends the visitor address.
# Sign-in limits then use the last hop in X-Forwarded-For.
TRUST_PROXY=

# Public origin Stripe uses for success and cancel URLs.
# Register xvaisle.com, point it at this host, then set APP_URL=https://xvaisle.com
APP_URL=http://127.0.0.1:4317

# Stripe secret key. Store checkout stays closed until this is set.
# Membership checkout is closed. Use a test key unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=

# Signing secret from the Stripe webhook endpoint pointed at /api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Signing secret for the Connect webhook pointed at /api/connect/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional. Defaults to 2026-07-29.dahlia. Sent as the Stripe-Version header.
STRIPE_API_VERSION=

# Ignored. Membership checkout is closed, so no recurring price is created.
STRIPE_MEMBERSHIP_PRICE_ID=

# Platform cut in basis points. Default 1000. Values outside 800–1200 are clamped.
PLATFORM_FEE_BPS=

# Estimated Stripe processing, taken from the reseller's share. Defaults 290 and 30.
# Values outside 0–1000 bps, or 0–100 cents, are clamped. Non-integers fall back to the default.
STRIPE_FEE_BPS=
STRIPE_FEE_FIXED_CENTS=

# Flat fee Stripe charges on a dispute, in cents. Default 1500. Clamped to 0–3500.
STRIPE_DISPUTE_FEE_CENTS=

# Lowest price the store will publish or check out, in cents. Default 500. Clamped to 100–100000.
MIN_RETAIL_CENTS=

# Lowest reseller payout after supplier cost and fees, in cents. Default 50. Clamped to 0–5000.
MIN_RESELLER_NET_CENTS=

# Reseller rolling reserve. Default 10% of each payout, up to $100.
# Released 120 days after the hold, or after a refund or dispute closes.
# RESELLER_RESERVE_DAYS clamps to 1–700. Non-integers fall back to the default.
RESELLER_RESERVE_BPS=
RESELLER_RESERVE_DAYS=
RESELLER_RESERVE_CAP_CENTS=

# Set to 1 only after a separate review. Live secret keys are refused until then.
STRIPE_ALLOW_LIVE=

# Set to 1 to turn off Link and US bank on the platform payment method configuration at boot.
STRIPE_CARD_CHECKOUT_ONLY=

# Optional mail. Any SMTP server works. If SMTP_HOST is empty, messages are logged and not sent.
# MAIL_FROM for the store is no-reply@xvaisle.com.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Business inbox for new-order and 24-hour reminders. Not a personal address. If empty, the alert is logged.
ORDER_ALERT_EMAIL=

# Encrypts authenticator secrets. Required in production before an admin can turn on 2FA.
AUTH_SECRET=

# Set to 1 to publish the sample sheet pan and bench scraper. Leave unset in production.
DEMO_SEED=

# Dates the 7-business-day delay email skips, besides weekends. Comma-separated YYYY-MM-DD.
# Leave empty to skip weekends only.
STORE_HOLIDAYS=

# Used only by `node scripts/admin-create.mjs`. Signup does not grant admin.
# Run the script once per owner. Leave the password empty to type it, or omit it
# when that email already has an account. Do not commit a real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional allowlist for the seed script. Comma-separated. Signup ignores it.
ADMIN_EMAILS=

# Optional path for the SQLite file. Defaults to data/xvaisle.sqlite
DATABASE_PATH=

# Used when a listing route is api. Both must be set or that order stays queued.
SUPPLIER_API_URL=
SUPPLIER_API_KEY=

# Shown on the policy pages when the desk has not saved one.
# Street, city, state, postal code. One line. Use a business address, not a home address.
STORE_RETURNS=
# Support email shown before the operator saves one. Example shape: name@example.com
STORE_SUPPORT_EMAIL=

# Required for the two starter products. If empty, no account receives them.
STORE_OPERATOR_EMAIL=

# X sign-in. All three must be set or the Continue with X button stays hidden.
# OAuth 2.0 Web App, confidential client. Scopes: users.read and tweet.read.
# The callback must match the portal exactly. The access token is not stored.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
